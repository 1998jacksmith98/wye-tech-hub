DATABASE_URL="file:./dev.db"
# Production: postgresql://USER:PASS@HOST/DB?sslmode=require

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Local UI testing without Microsoft (set false in production)
AUTH_DEV_MODE="true"

# Microsoft Entra ID (Azure AD) app registration
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Tenant ID, or "common" / "organizations"
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Who can join the WYE org on first login
ALLOWED_EMAIL_DOMAINS="webbyates.com"
ALLOWED_EMAILS=""

# SharePoint document library drive (from Graph)
SHAREPOINT_DRIVE_ID=""
SHAREPOINT_SITE_ID=""
